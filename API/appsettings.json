{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=YOUR_SERVER;Database=BankDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_SECRET_IN_USER_SECRETS",
    "Issuer": "BankAPI",
    "Audience": "BankClients",
    "ExpiresMinutes": 60
  }
}